# Envio dos leads do formulário de contato (https://resend.com).
# Sem estas variáveis o formulário valida normalmente, mas responde com uma
# mensagem de erro amigável e registra o lead no log do servidor.

# Chave de API da Resend.
RESEND_API_KEY=

# Remetente. Precisa ser um endereço de domínio verificado na Resend,
# ex.: "DL Company <site@dlcompany.com.br>".
LEAD_FROM_EMAIL=

# Caixa que recebe os leads. Se ficar vazio, usa o e-mail de lib/site.ts.
LEAD_TO_EMAIL=
